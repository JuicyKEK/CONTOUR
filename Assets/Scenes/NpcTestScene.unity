  m_text: "\u0422\u0435\u0441\u0442\u043E\u0432\u0430\u044F \u0441\u0446\u0435\u043D\u0430
    \u0431\u043E\u0442\u043E\u0432\n\u0437\u0430\u043F\u0430\u0434 - \u0433\u0430\u0437\u043E\u0432\u0449\u0438\u043A,
    \u0432\u043E\u0441\u0442\u043E\u043A - \u0431\u0443\u0434\u043A\u0430 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430\n\u0441\u0435\u0432\u0435\u0440
    - \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F (\u044F\u0432\u043D\u044B\u0439
    \u043C\u0438\u043C\u0438\u043A)\n\u044E\u0433\u043E-\u0432\u043E\u0441\u0442\u043E\u043A
    - \u043C\u043E\u043D\u0441\u0442\u0440, \u044E\u0433\u043E-\u0437\u0430\u043F\u0430\u0434
    - \u043E\u0445\u043E\u0442\u043D\u0438\u043A"
